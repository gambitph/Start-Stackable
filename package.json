	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"start": "wp-scripts start",
		"compile": "wp-scripts build",
		"package": "node scripts/package.js",
		"build": "npm run compile && node scripts/package.js ${npm_config_suffix}",
