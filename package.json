		"test:debug": "npx playwright test --ui"
	},
	"devDependencies": {
		"@playwright/test": "^1.49.1",
		"@types/node": "^20.17.10",
		"@wordpress/e2e-test-utils-playwright": "^1.14.0",
		"@wordpress/scripts": "^34.1.0",
		"@wp-playground/cli": "^3.1.49",
		"archiver": "^6.0.2"
	}
}
