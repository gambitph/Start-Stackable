{
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "layout": {
            "contentSize": "645px",
            "wideSize": "1340px"
        },
        "border": {
            "radiusSizes": [
                {
                    "name": "Small",
                    "slug": "small",
                    "size": "4px"
                },
                {
                    "name": "Medium",
                    "slug": "medium",
                    "size": "8px"
                },
                {
                    "name": "Large",
                    "slug": "large",
                    "size": "16px"
                },
                {
                    "name": "Full",
                    "slug": "full",
                    "size": "9999px"
                }
            ]
        },
        "color": {
            "defaultPalette": false,
            "defaultGradients": false,
            "defaultDuotone": false,
            "palette": [
                {
                    "name": "Primary",
                    "slug": "primary",
                    "color": "#3B82F6"
                },
                {
                    "name": "Primary Light",
                    "slug": "primary-light",
                    "color": "#60A5FA"
                },
                {
                    "name": "Primary Soft",
                    "slug": "primary-soft",
                    "color": "#93C5FD"
                },
                {
                    "name": "Primary Deep",
                    "slug": "primary-deep",
                    "color": "#1E3A8A"
                },
                {
                    "name": "Base",
                    "slug": "base",
                    "color": "#FFFFFF"
                },
                {
                    "name": "Base Accent",
                    "slug": "base-accent",
                    "color": "#E2E8F0"
                },
                {
                    "name": "Tint",
                    "slug": "tint",
                    "color": "#F8FAFC"
                },
                {
                    "name": "Contrast",
                    "slug": "contrast",
                    "color": "#000000"
                },
                {
                    "name": "Contrast Accent",
                    "slug": "contrast-accent",
                    "color": "#64748B"
                },
                {
                    "name": "Outline",
                    "slug": "outline",
                    "color": "#BFDBFE"
                },
                {
                    "name": "Outline Contrast",
                    "slug": "outline-contrast",
                    "color": "#0A2540"
                }
            ]
        },
        "shadow": {
            "presets": [
                {
                    "name": "Small",
                    "slug": "small",
                    "shadow": "0 1px 2px rgb(15 23 42 / 0.08)"
                },
                {
                    "name": "Medium",
                    "slug": "medium",
                    "shadow": "0 8px 24px rgb(15 23 42 / 0.1)"
                },
                {
                    "name": "Large",
                    "slug": "large",
                    "shadow": "0 24px 56px rgb(15 23 42 / 0.14)"
                }
            ]
        },
        "spacing": {
            "defaultSpacingSizes": false,
            "spacingSizes": [
                {
                    "name": "S",
                    "size": "clamp(0.375rem, 0.34rem + 0.18vw, 0.5rem)",
                    "slug": "small"
                },
                {
                    "name": "M",
                    "size": "clamp(0.75rem, 0.68rem + 0.35vw, 1rem)",
                    "slug": "medium"
                },
                {
                    "name": "L",
                    "size": "clamp(1rem, 0.86rem + 0.7vw, 1.5rem)",
                    "slug": "large"
                },
                {
                    "name": "XL",
                    "size": "clamp(1.25rem, 1.04rem + 1.05vw, 2rem)",
                    "slug": "x-large"
                },
                {
                    "name": "2XL",
                    "size": "clamp(1.5rem, 1.08rem + 2.1vw, 3rem)",
                    "slug": "xx-large"
                },
                {
                    "name": "3XL",
                    "size": "clamp(2rem, 1.44rem + 2.8vw, 4rem)",
                    "slug": "xxx-large"
                },
                {
                    "name": "4XL",
                    "size": "clamp(3rem, 2.16rem + 4.2vw, 6rem)",
                    "slug": "xxxx-large"
                }
            ],
            "units": [
                "%",
                "px",
                "em",
                "rem",
                "vh",
                "vw"
            ]
        },
        "typography": {
            "fluid": true,
            "writingMode": true,
            "defaultFontSizes": false,
            "fontSizes": [
                {
                    "name": "XS",
                    "size": "0.875rem",
                    "slug": "x-small",
                    "fluid": {
                        "min": "0.8125rem",
                        "max": "0.875rem"
                    }
                },
                {
                    "name": "S",
                    "size": "1rem",
                    "slug": "small",
                    "fluid": {
                        "min": "0.9375rem",
                        "max": "1rem"
                    }
                },
                {
                    "name": "M",
                    "size": "1.125rem",
                    "slug": "medium",
                    "fluid": {
                        "min": "1rem",
                        "max": "1.125rem"
                    }
                },
                {
                    "name": "L",
                    "size": "1.5rem",
                    "slug": "large",
                    "fluid": {
                        "min": "1.25rem",
                        "max": "1.5rem"
                    }
                },
                {
                    "name": "XL",
                    "size": "2rem",
                    "slug": "x-large",
                    "fluid": {
                        "min": "1.5rem",
                        "max": "2rem"
                    }
                },
                {
                    "name": "2XL",
                    "size": "3rem",
                    "slug": "xx-large",
                    "fluid": {
                        "min": "2rem",
                        "max": "3rem"
                    }
                },
                {
                    "name": "3XL",
                    "size": "4rem",
                    "slug": "xxx-large",
                    "fluid": {
                        "min": "2.5rem",
                        "max": "4rem"
                    }
                }
            ],
            "fontFamilies": [
                {
                    "name": "Sans-serif",
                    "slug": "sans-serif",
                    "fontFamily": "-apple-system, BlinkMacSystemFont, avenir next, avenir, segoe ui, helvetica neue, Adwaita Sans, Cantarell, Ubuntu, roboto, noto, helvetica, arial, sans-serif",
                    "fontWeight": "200 800"
                },
                {
                    "name": "Plus Jakarta Sans",
                    "slug": "plus-jakarta-sans",
                    "fontFamily": "\"Plus Jakarta Sans\", sans-serif",
                    "fontFace": [
                        {
                            "fontFamily": "Plus Jakarta Sans",
                            "fontWeight": "200 800",
                            "fontStyle": "normal",
                            "src": [
                                "file:./assets/fonts/plus-jakarta-sans.woff2"
                            ]
                        }
                    ]
                }
            ]
        },
        "useRootPaddingAwareAlignments": true
    },
    "styles": {
        "css": ":root :where(.is-layout-constrained) > * { margin-block-start: 0; margin-block-end: 24px; }",
        "typography": {
            "fontFamily": "var:preset|font-family|sans-serif",
            "fontSize": "var:preset|font-size|medium"
        },
        "color": {
            "background": "var:preset|color|base",
            "text": "var:preset|color|contrast"
        },
        "spacing": {
            "blockGap": "24px"
        },
        "blocks": {
            "core/button": {
                "spacing": {
                    "margin": {
                        "top": "0px",
                        "bottom": "var:preset|spacing|large"
                    }
                },
                "border": {
                    "radius": "var:preset|border-radius|medium"
                },
                "variations": {
                    "outline": {
                        "border": {
                            "color": "var:preset|color|primary-deep",
                            "radius": "var:preset|border-radius|medium",
                            "width": "2px"
                        },
                        "color": {
                            "text": "var:preset|color|primary-deep",
                            "background": "var:preset|color|base"
                        }
                    }
                }
            },
            "core/navigation": {
                "color": {
                    "text": "var:preset|color|outline-contrast"
                },
                "elements": {
                    "link": {
                        "color": {
                            "text": "var:preset|color|outline-contrast"
                        },
                        "typography": {
                            "textDecoration": "none"
                        },
                        ":hover": {
                            "color": {
                                "text": "var:preset|color|primary-deep"
                            },
                            "typography": {
                                "textDecoration": "underline"
                            }
                        }
                    }
                },
                "typography": {
                    "fontSize": "var:preset|font-size|small",
                    "fontWeight": "600"
                }
            },
            "core/site-title": {
                "elements": {
                    "link": {
                        "typography": {
                            "textDecoration": "none"
                        },
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        }
                    }
                },
                "typography": {
                    "fontFamily": "var:preset|font-family|plus-jakarta-sans",
                    "fontSize": "var:preset|font-size|large",
                    "fontWeight": "700",
                    "lineHeight": "1.15"
                }
            },
            "core/quote": {
                "border": {
                    "color": "var:preset|color|primary",
                    "style": "solid",
                    "width": "0 0 0 4px"
                },
                "color": {
                    "background": "var:preset|color|tint",
                    "text": "var:preset|color|outline-contrast"
                },
                "elements": {
                    "cite": {
                        "color": {
                            "text": "var:preset|color|contrast-accent"
                        },
                        "typography": {
                            "fontSize": "var:preset|font-size|small",
                            "fontStyle": "normal"
                        }
                    }
                },
                "spacing": {
                    "padding": {
                        "top": "var:preset|spacing|large",
                        "right": "var:preset|spacing|large",
                        "bottom": "var:preset|spacing|large",
                        "left": "var:preset|spacing|large"
                    }
                },
                "typography": {
                    "fontSize": "var:preset|font-size|large",
                    "lineHeight": "1.5"
                }
            },
            "core/pullquote": {
                "border": {
                    "color": "var:preset|color|primary-deep",
                    "style": "solid",
                    "width": "2px 0"
                },
                "color": {
                    "text": "var:preset|color|outline-contrast"
                },
                "elements": {
                    "cite": {
                        "color": {
                            "text": "var:preset|color|contrast-accent"
                        },
                        "typography": {
                            "fontFamily": "var:preset|font-family|sans-serif",
                            "fontSize": "var:preset|font-size|small",
                            "fontStyle": "normal"
                        }
                    }
                },
                "spacing": {
                    "padding": {
                        "top": "var:preset|spacing|large",
                        "bottom": "var:preset|spacing|large"
                    }
                },
                "typography": {
                    "fontFamily": "var:preset|font-family|plus-jakarta-sans",
                    "fontSize": "var:preset|font-size|x-large",
                    "fontWeight": "600",
                    "lineHeight": "1.3"
                }
            },
            "core/separator": {
                "border": {
                    "color": "var:preset|color|outline",
                    "style": "solid",
                    "width": "0 0 2px 0"
                },
                "color": {
                    "text": "var:preset|color|outline"
                }
            },
            "core/search": {
                "border": {
                    "color": "var:preset|color|outline",
                    "radius": "var:preset|border-radius|medium"
                },
                "elements": {
                    "button": {
                        "border": {
                            "radius": "var:preset|border-radius|medium"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var:preset|font-size|medium"
                }
            },
            "core/query-pagination": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "var:preset|color|primary-deep"
                        },
                        "typography": {
                            "textDecoration": "none"
                        },
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        }
                    }
                },
                "typography": {
                    "fontSize": "var:preset|font-size|small",
                    "fontWeight": "600"
                }
            },
            "core/post-title": {
                "elements": {
                    "link": {
                        "typography": {
                            "textDecoration": "none"
                        },
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        }
                    }
                },
                "typography": {
                    "fontFamily": "var:preset|font-family|plus-jakarta-sans",
                    "fontWeight": "700",
                    "lineHeight": "1.15"
                }
            },
            "core/post-terms": {
                "color": {
                    "text": "var:preset|color|contrast-accent"
                },
                "elements": {
                    "link": {
                        "color": {
                            "text": "var:preset|color|primary-deep"
                        },
                        "typography": {
                            "textDecoration": "none"
                        },
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        }
                    }
                },
                "typography": {
                    "fontSize": "var:preset|font-size|small",
                    "fontWeight": "600"
                }
            },
            "core/post-comments-form": {
                "color": {
                    "text": "var:preset|color|outline-contrast"
                },
                "spacing": {
                    "padding": {
                        "top": "var:preset|spacing|large",
                        "bottom": "var:preset|spacing|large"
                    }
                },
                "typography": {
                    "fontSize": "var:preset|font-size|medium",
                    "lineHeight": "1.5"
                }
            }
        },
        "elements": {
            "heading": {
                "typography": {
                    "fontFamily": "var:preset|font-family|plus-jakarta-sans"
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "var:preset|font-size|xx-large",
                    "fontWeight": "700",
                    "lineHeight": "1.1"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var:preset|font-size|x-large",
                    "fontWeight": "700",
                    "lineHeight": "1.15"
                }
            },
            "h3": {
                "typography": {
                    "fontSize": "var:preset|font-size|large",
                    "fontWeight": "600",
                    "lineHeight": "1.2"
                }
            },
            "h4": {
                "typography": {
                    "fontSize": "var:preset|font-size|medium",
                    "fontWeight": "600",
                    "lineHeight": "1.25"
                }
            },
            "h5": {
                "typography": {
                    "fontSize": "var:preset|font-size|small",
                    "fontWeight": "600",
                    "lineHeight": "1.3"
                }
            },
            "h6": {
                "typography": {
                    "fontSize": "var:preset|font-size|x-small",
                    "fontWeight": "600",
                    "lineHeight": "1.3"
                }
            },
            "link": {
                "color": {
                    "text": "var:preset|color|primary-deep"
                },
                "typography": {
                    "textDecoration": "underline"
                }
            },
            "button": {
                "color": {
                    "text": "var:preset|color|base",
                    "background": "var:preset|color|primary-deep"
                },
                "spacing": {
                    "padding": {
                        "top": "var:preset|spacing|small",
                        "right": "var:preset|spacing|medium",
                        "bottom": "var:preset|spacing|small",
                        "left": "var:preset|spacing|medium"
                    }
                },
                "typography": {
                    "fontWeight": "600",
                    "lineHeight": "1.2",
                    "textDecoration": "none"
                }
            },
            "caption": {
                "color": {
                    "text": "var:preset|color|contrast-accent"
                },
                "typography": {
                    "fontSize": "var:preset|font-size|small",
                    "lineHeight": "1.5"
                }
            }
        }
    },
    "customTemplates": [
        {
            "name": "blank",
            "title": "Blank Canvas",
            "postTypes": [
                "page",
                "post"
            ]
        },
        {
            "name": "full-width",
            "title": "Full Width",
            "postTypes": [
                "page",
                "post"
            ]
        }
    ],
    "templateParts": [
        {
            "name": "header",
            "title": "Header",
            "area": "header"
        },
        {
            "name": "header-transparent",
            "title": "Header Transparent",
            "area": "header"
        },
        {
            "name": "header-minimal",
            "title": "Header Minimal",
            "area": "header"
        },
        {
            "name": "footer",
            "title": "Footer",
            "area": "footer"
        },
        {
            "name": "footer-landing",
            "title": "Footer Landing",
            "area": "footer"
        }
    ]
}
