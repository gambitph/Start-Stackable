{
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "layout": {
            "contentSize": "645px",
            "wideSize": "1340px"
        },
        "border": {
            "radiusSizes": [
                {
                    "name": "Small",
                    "slug": "small",
                    "size": "4px"
                },
                {
                    "name": "Medium",
                    "slug": "medium",
                    "size": "12px"
                },
                {
                    "name": "Large",
                    "slug": "large",
                    "size": "20px"
                },
                {
                    "name": "Full",
                    "slug": "full",
                    "size": "9999px"
                }
            ]
        },
        "color": {
            "defaultPalette": false,
            "defaultGradients": false,
            "defaultDuotone": false,
            "palette": [
                {
                    "name": "Primary",
                    "slug": "primary",
                    "color": "#DBE8FB"
                },
                {
                    "name": "Primary Deep",
                    "slug": "primary-deep",
                    "color": "#140018"
                },
                {
                    "name": "Contrast Accent",
                    "slug": "contrast-accent",
                    "color": "#645D73"
                },
                {
                    "name": "Outline Contrast",
                    "slug": "outline-contrast",
                    "color": "#140018"
                },
                {
                    "name": "Outline",
                    "slug": "outline",
                    "color": "#E8E3EA"
                },
                {
                    "name": "Base Accent",
                    "slug": "base-accent",
                    "color": "#E7F0FD"
                },
                {
                    "name": "Tint",
                    "slug": "tint",
                    "color": "#F4F8FE"
                },
                {
                    "name": "Base",
                    "slug": "base",
                    "color": "#FFFFFF"
                }
            ]
        },
        "shadow": {
            "defaultPresets": true,
            "presets": [
                {
                    "name": "Shadow 1",
                    "slug": "shadow-1",
                    "shadow": "0 0 0 1px #7878781a"
                },
                {
                    "name": "Shadow 2",
                    "slug": "shadow-2",
                    "shadow": "0 0 0 2px #7878781a"
                },
                {
                    "name": "Shadow 3",
                    "slug": "shadow-3",
                    "shadow": "0 5px 5px 0 #123f5209"
                },
                {
                    "name": "Shadow 4",
                    "slug": "shadow-4",
                    "shadow": "0px 2px 20px #99999933"
                },
                {
                    "name": "Shadow 5",
                    "slug": "shadow-5",
                    "shadow": "0 5px 30px -10px #123f524d"
                },
                {
                    "name": "Shadow 6",
                    "slug": "shadow-6",
                    "shadow": "0px 10px 30px #0000000d"
                },
                {
                    "name": "Shadow 7",
                    "slug": "shadow-7",
                    "shadow": "7px 5px 30px #48497927"
                },
                {
                    "name": "Shadow 8",
                    "slug": "shadow-8",
                    "shadow": "0px 10px 60px #0000001a"
                },
                {
                    "name": "Shadow 9",
                    "slug": "shadow-9",
                    "shadow": "0px 70px 90px -20px #4849794d"
                }
            ]
        },
        "spacing": {
            "defaultSpacingSizes": false,
            "spacingSizes": [
                {
                    "name": "S",
                    "size": "clamp(0.375rem, 0.34rem + 0.18vw, 0.5rem)",
                    "slug": "small"
                },
                {
                    "name": "M",
                    "size": "clamp(0.75rem, 0.68rem + 0.35vw, 1rem)",
                    "slug": "medium"
                },
                {
                    "name": "L",
                    "size": "clamp(1rem, 0.86rem + 0.7vw, 1.5rem)",
                    "slug": "large"
                },
                {
                    "name": "XL",
                    "size": "clamp(1.25rem, 1.04rem + 1.05vw, 2rem)",
                    "slug": "x-large"
                },
                {
                    "name": "2XL",
                    "size": "clamp(1.5rem, 1.08rem + 2.1vw, 3rem)",
                    "slug": "xx-large"
                },
                {
                    "name": "3XL",
                    "size": "clamp(3rem, 2.16rem + 4.2vw, 6rem)",
                    "slug": "xxx-large"
                },
                {
                    "name": "4XL",
                    "size": "clamp(4rem, 2.6rem + 7vw, 9rem)",
                    "slug": "xxxx-large"
                }
            ],
            "units": [
                "%",
                "px",
                "em",
                "rem",
                "vh",
                "vw"
            ]
        },
        "typography": {
            "fluid": true,
            "writingMode": true,
            "defaultFontSizes": false,
            "fontSizes": [
                {
                    "name": "XS",
                    "size": "0.875rem",
                    "slug": "x-small",
                    "fluid": {
                        "min": "0.8125rem",
                        "max": "0.875rem"
                    }
                },
                {
                    "name": "S",
                    "size": "1rem",
                    "slug": "small",
                    "fluid": {
                        "min": "0.9375rem",
                        "max": "1rem"
                    }
                },
                {
                    "name": "M",
                    "size": "1.125rem",
                    "slug": "medium",
                    "fluid": {
                        "min": "1rem",
                        "max": "1.125rem"
                    }
                },
                {
                    "name": "L",
                    "size": "1.75rem",
                    "slug": "large",
                    "fluid": {
                        "min": "1.25rem",
                        "max": "1.75rem"
                    }
                },
                {
                    "name": "XL",
                    "size": "2.5rem",
                    "slug": "x-large",
                    "fluid": {
                        "min": "1.5rem",
                        "max": "2.5rem"
                    }
                },
                {
                    "name": "2XL",
                    "size": "4rem",
                    "slug": "xx-large",
                    "fluid": {
                        "min": "2.25rem",
                        "max": "4rem"
                    }
                },
                {
                    "name": "3XL",
                    "size": "7rem",
                    "slug": "xxx-large",
                    "fluid": {
                        "min": "2.75rem",
                        "max": "7rem"
                    }
                }
            ],
            "fontFamilies": [
                {
                    "name": "Sans-serif",
                    "slug": "sans-serif",
                    "fontFamily": "-apple-system, BlinkMacSystemFont, avenir next, avenir, segoe ui, helvetica neue, Adwaita Sans, Cantarell, Ubuntu, roboto, noto, helvetica, arial, sans-serif",
                    "fontWeight": "200 800"
                },
                {
                    "name": "Plus Jakarta Sans",
                    "slug": "plus-jakarta-sans",
                    "fontFamily": "\"Plus Jakarta Sans\", sans-serif",
                    "fontFace": [
                        {
                            "fontFamily": "Plus Jakarta Sans",
                            "fontWeight": "200 800",
                            "fontStyle": "normal",
                            "src": [
                                "file:./assets/fonts/plus-jakarta-sans.woff2"
                            ]
                        }
                    ]
                }
            ]
        },
        "useRootPaddingAwareAlignments": true
    },
    "styles": {
        "typography": {
            "fontFamily": "var:preset|font-family|sans-serif",
            "fontSize": "var:preset|font-size|medium",
            "fontWeight": "500",
            "lineHeight": "1.55"
        },
        "color": {
            "background": "var:preset|color|base",
            "text": "var:preset|color|contrast-accent"
        },
        "spacing": {
            "blockGap": "var:preset|spacing|large"
        },
        "blocks": {
            "core/button": {
                "border": {
                    "radius": "var:preset|border-radius|full"
                },
                "typography": {
                    "fontSize": "var:preset|font-size|small",
                    "fontWeight": "600",
                    "lineHeight": "1.2"
                },
                "variations": {
                    "outline": {
                        "border": {
                            "color": "var:preset|color|primary-deep",
                            "radius": "var:preset|border-radius|full",
                            "width": "1px"
                        },
                        "color": {
                            "text": "var:preset|color|primary-deep",
                            "background": "transparent"
                        }
                    }
                }
            },
            "core/navigation": {
                "color": {
                    "text": "var:preset|color|outline-contrast"
                },
                "elements": {
                    "link": {
                        "color": {
                            "text": "var:preset|color|outline-contrast"
                        },
                        "typography": {
                            "textDecoration": "none"
                        },
                        ":hover": {
                            "color": {
                                "text": "var:preset|color|primary-deep"
                            },
                            "typography": {
                                "textDecoration": "underline"
                            }
                        }
                    }
                },
                "typography": {
                    "fontSize": "var:preset|font-size|small",
                    "fontWeight": "500",
                    "lineHeight": "1.5"
                }
            },
            "core/site-title": {
                "elements": {
                    "link": {
                        "typography": {
                            "textDecoration": "none"
                        },
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        }
                    }
                },
                "typography": {
                    "fontFamily": "var:preset|font-family|plus-jakarta-sans",
                    "fontSize": "var:preset|font-size|large",
                    "fontWeight": "800",
                    "letterSpacing": "-0.03em",
                    "lineHeight": "1"
                }
            },
            "core/quote": {
                "border": {
                    "radius": "var:preset|border-radius|large",
                    "style": "none",
                    "width": "0"
                },
                "color": {
                    "background": "var:preset|color|base-accent",
                    "text": "var:preset|color|outline-contrast"
                },
                "elements": {
                    "cite": {
                        "color": {
                            "text": "var:preset|color|contrast-accent"
                        },
                        "typography": {
                            "fontSize": "var:preset|font-size|small",
                            "fontStyle": "normal"
                        }
                    }
                },
                "spacing": {
                    "padding": {
                        "top": "var:preset|spacing|x-large",
                        "right": "var:preset|spacing|x-large",
                        "bottom": "var:preset|spacing|x-large",
                        "left": "var:preset|spacing|x-large"
                    }
                },
                "typography": {
                    "fontSize": "var:preset|font-size|large",
                    "fontWeight": "500",
                    "lineHeight": "1.4"
                }
            },
            "core/pullquote": {
                "border": {
                    "radius": "var:preset|border-radius|large",
                    "style": "none",
                    "width": "0"
                },
                "color": {
                    "background": "var:preset|color|primary-deep",
                    "text": "var:preset|color|base"
                },
                "elements": {
                    "cite": {
                        "color": {
                            "text": "var:preset|color|base"
                        },
                        "typography": {
                            "fontFamily": "var:preset|font-family|sans-serif",
                            "fontSize": "var:preset|font-size|small",
                            "fontStyle": "normal"
                        }
                    }
                },
                "spacing": {
                    "padding": {
                        "top": "var:preset|spacing|xx-large",
                        "right": "var:preset|spacing|xx-large",
                        "bottom": "var:preset|spacing|xx-large",
                        "left": "var:preset|spacing|xx-large"
                    }
                },
                "typography": {
                    "fontFamily": "var:preset|font-family|plus-jakarta-sans",
                    "fontSize": "var:preset|font-size|x-large",
                    "fontWeight": "600",
                    "letterSpacing": "-0.02em",
                    "lineHeight": "1.2"
                }
            },
            "core/separator": {
                "border": {
                    "color": "var:preset|color|outline",
                    "style": "solid",
                    "width": "0 0 1px 0"
                },
                "color": {
                    "text": "var:preset|color|outline"
                }
            },
            "core/search": {
                "border": {
                    "color": "var:preset|color|outline",
                    "radius": "var:preset|border-radius|full",
                    "style": "solid",
                    "width": "1px"
                },
                "elements": {
                    "button": {
                        "border": {
                            "radius": "var:preset|border-radius|full"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var:preset|font-size|medium"
                }
            },
            "core/query-pagination": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "var:preset|color|primary-deep"
                        },
                        "typography": {
                            "textDecoration": "none"
                        },
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        }
                    }
                },
                "typography": {
                    "fontSize": "var:preset|font-size|small",
                    "fontWeight": "600"
                }
            },
            "core/post-title": {
                "elements": {
                    "link": {
                        "typography": {
                            "textDecoration": "none"
                        },
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        }
                    }
                },
                "typography": {
                    "fontFamily": "var:preset|font-family|plus-jakarta-sans",
                    "fontWeight": "600",
                    "letterSpacing": "-0.02em",
                    "lineHeight": "1.1"
                }
            },
            "core/post-terms": {
                "color": {
                    "text": "var:preset|color|contrast-accent"
                },
                "elements": {
                    "link": {
                        "color": {
                            "text": "var:preset|color|primary-deep"
                        },
                        "typography": {
                            "textDecoration": "none"
                        },
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        }
                    }
                },
                "typography": {
                    "fontSize": "var:preset|font-size|small",
                    "fontWeight": "600"
                }
            },
            "core/post-comments-form": {
                "color": {
                    "text": "var:preset|color|outline-contrast"
                },
                "spacing": {
                    "padding": {
                        "top": "var:preset|spacing|large",
                        "bottom": "var:preset|spacing|large"
                    }
                },
                "typography": {
                    "fontSize": "var:preset|font-size|medium",
                    "lineHeight": "1.5"
                }
            },
            "core/image": {
                "border": {
                    "radius": "var:preset|border-radius|medium"
                }
            },
            "core/post-excerpt": {
                "color": {
                    "text": "var:preset|color|contrast-accent"
                },
                "typography": {
                    "lineHeight": "1.55"
                }
            },
            "core/read-more": {
                "typography": {
                    "fontSize": "var:preset|font-size|small",
                    "fontWeight": "600",
                    "textDecoration": "none"
                }
            },
            "core/table": {
                "border": {
                    "color": "var:preset|color|outline"
                },
                "typography": {
                    "fontSize": "var:preset|font-size|small",
                    "lineHeight": "1.5"
                }
            }
        },
        "elements": {
            "heading": {
                "color": {
                    "text": "var:preset|color|outline-contrast"
                },
                "typography": {
                    "fontFamily": "var:preset|font-family|plus-jakarta-sans",
                    "letterSpacing": "-0.02em"
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "var:preset|font-size|xx-large",
                    "fontWeight": "800",
                    "letterSpacing": "-0.035em",
                    "lineHeight": "0.98"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var:preset|font-size|x-large",
                    "fontWeight": "600",
                    "letterSpacing": "-0.025em",
                    "lineHeight": "1.04"
                }
            },
            "h3": {
                "typography": {
                    "fontSize": "var:preset|font-size|large",
                    "fontWeight": "600",
                    "letterSpacing": "-0.01em",
                    "lineHeight": "1.15"
                }
            },
            "h4": {
                "typography": {
                    "fontSize": "var:preset|font-size|medium",
                    "fontWeight": "600",
                    "lineHeight": "1.25"
                }
            },
            "h5": {
                "typography": {
                    "fontSize": "var:preset|font-size|small",
                    "fontWeight": "600",
                    "lineHeight": "1.3"
                }
            },
            "h6": {
                "typography": {
                    "fontSize": "var:preset|font-size|x-small",
                    "fontWeight": "600",
                    "lineHeight": "1.3"
                }
            },
            "link": {
                "color": {
                    "text": "var:preset|color|primary-deep"
                },
                "typography": {
                    "textDecoration": "underline"
                }
            },
            "button": {
                "border": {
                    "radius": "var:preset|border-radius|full"
                },
                "color": {
                    "text": "var:preset|color|base",
                    "background": "var:preset|color|primary-deep"
                },
                "spacing": {
                    "padding": {
                        "top": "var:preset|spacing|medium",
                        "right": "var:preset|spacing|large",
                        "bottom": "var:preset|spacing|medium",
                        "left": "var:preset|spacing|large"
                    }
                },
                "typography": {
                    "fontWeight": "600",
                    "lineHeight": "1.2",
                    "textDecoration": "none"
                },
                ":hover": {
                    "color": {
                        "text": "var:preset|color|outline-contrast",
                        "background": "var:preset|color|base-accent"
                    },
                    "typography": {
                        "textDecoration": "none"
                    }
                }
            },
            "textInput": {
                "border": {
                    "color": "var:preset|color|outline",
                    "radius": "var:preset|border-radius|medium",
                    "style": "solid",
                    "width": "1px"
                },
                "color": {
                    "background": "var:preset|color|base",
                    "text": "var:preset|color|outline-contrast"
                },
                "spacing": {
                    "padding": {
                        "top": "var:preset|spacing|small",
                        "right": "var:preset|spacing|medium",
                        "bottom": "var:preset|spacing|small",
                        "left": "var:preset|spacing|medium"
                    }
                }
            },
            "select": {
                "border": {
                    "color": "var:preset|color|outline",
                    "radius": "var:preset|border-radius|medium",
                    "style": "solid",
                    "width": "1px"
                },
                "color": {
                    "background": "var:preset|color|base",
                    "text": "var:preset|color|outline-contrast"
                },
                "spacing": {
                    "padding": {
                        "top": "var:preset|spacing|small",
                        "right": "var:preset|spacing|medium",
                        "bottom": "var:preset|spacing|small",
                        "left": "var:preset|spacing|medium"
                    }
                }
            },
            "caption": {
                "color": {
                    "text": "var:preset|color|contrast-accent"
                },
                "typography": {
                    "fontSize": "var:preset|font-size|small",
                    "lineHeight": "1.5"
                }
            }
        }
    },
    "customTemplates": [
        {
            "name": "blank",
            "title": "Blank Canvas",
            "postTypes": [
                "page",
                "post"
            ]
        },
        {
            "name": "full-width",
            "title": "Full Width, No Title",
            "postTypes": [
                "page",
                "post"
            ]
        },
        {
            "name": "page-with-sidebar",
            "title": "Page with Sidebar",
            "postTypes": [
                "page",
                "post"
            ]
        }
    ],
    "templateParts": [
        {
            "name": "header",
            "title": "Header",
            "area": "header"
        },
        {
            "name": "header-sticky",
            "title": "Header Sticky",
            "area": "header"
        },
        {
            "name": "header-transparent",
            "title": "Header Sticky Transparent",
            "area": "header"
        },
        {
            "name": "header-minimal",
            "title": "Header Minimal",
            "area": "header"
        },
        {
            "name": "footer",
            "title": "Footer",
            "area": "footer"
        },
        {
            "name": "footer-landing",
            "title": "Footer Landing",
            "area": "footer"
        },
        {
            "name": "sidebar",
            "title": "Sidebar",
            "area": "uncategorized"
        }
    ]
}
